# Backend API manzili.
#
# Dev: bo'sh qoldiring yoki /api — vite.config.js dagi proxy localhost:4000 ga
# yo'naltiradi.
# Vercel: Railway bergan to'liq manzilni /api bilan birga kiriting, masalan
#   VITE_API_URL=https://myhouse-api.up.railway.app/api
#
# Bu qiymat build paytida bundle ichiga yoziladi — Vercel'da o'zgartirsangiz,
# qayta deploy qilish shart.
VITE_API_URL=/api
