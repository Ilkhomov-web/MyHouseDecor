{
  "name": "myhouseshop",
  "version": "1.0.0",
  "private": true,
  "description": "MyhouseShop - Do'kon boshqaruv tizimi (CRM)",
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "cross-env NODE_ENV=production npm --prefix server run start",
    "seed": "npm --prefix server run seed",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "reset-password": "npm --prefix server run reset-password --",
    "setup": "npm --prefix server run setup --",
    "backup": "npm --prefix server run backup --"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3"
  }
}
