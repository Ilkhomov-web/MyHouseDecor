PORT=4000

# Majburiy. Tasodifiy uzun qiymat yarating:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production'da sozlanmasa yoki 32 belgidan qisqa bo'lsa server ishga tushmaydi.
JWT_SECRET=

JWT_EXPIRES_IN=7d

# Ruxsat etilgan frontend manzillari, vergul bilan ajratiladi.
# Vercel'da bittadan ko'p domen bo'ladi: asosiy domen + har bir preview deploy.
# Preview'lar uchun `*.` shabloni ishlatiladi.
#   https://myhouse.vercel.app,https://*.vercel.app
# Bitta serverda (client/dist ni server o'zi uzatsa) CORS umuman kerak emas.
CLIENT_ORIGIN=http://localhost:5173

NODE_ENV=development

# SQLite fayl yo'li. Railway'da MAJBURIY Volume ichida bo'lishi kerak
# (masalan /data/myhouseshop.db), aks holda har deploy'da baza o'chib ketadi.
DB_PATH=./data/myhouseshop.db

# nginx / Render / Railway kabi reverse proxy ortida ishlaganda 'true' qiling,
# aks holda barcha so'rovlar bitta IP dan kelgandek ko'rinib, login cheklovi
# hamma foydalanuvchilarni birga bloklaydi.
TRUST_PROXY=false

# Brauzer sessiya cookie'sini faqat HTTPS orqali saqlashi kerakmi.
# HTTPS bor bo'lsa: true. Ichki tarmoqda (http://192.168.x.x) MAJBURIY false —
# aks holda login 200 qaytaradi, lekin cookie saqlanmay foydalanuvchi
# login sahifasiga qaytariladi.
COOKIE_SECURE=false

# Cookie'ning SameSite rejimi. Bo'sh qoldirilsa: COOKIE_SECURE=true bo'lsa
# 'none', aks holda 'lax'.
# Frontend va backend ALOHIDA domenlarda bo'lsa (Vercel + Railway) 'none' shart,
# u esa faqat COOKIE_SECURE=true bilan ishlaydi.
COOKIE_SAMESITE=

# Birinchi administrator. Faqat foydalanuvchilar jadvali BUTUNLAY bo'sh bo'lsa
# ishlaydi — qayta deploy mavjud hisobni o'zgartirmaydi. Do'kon ishga tushgach
# bu o'zgaruvchilarni hosting paneldan o'chirib tashlang.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=

# Serverni tarmoqda ochish. 127.0.0.1 — faqat shu kompyuter.
HOST=0.0.0.0
