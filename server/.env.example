PORT=4000

# Majburiy. Tasodifiy uzun qiymat yarating:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production'da sozlanmasa yoki 32 belgidan qisqa bo'lsa server ishga tushmaydi.
JWT_SECRET=

JWT_EXPIRES_IN=7d

# Faqat dev uchun kerak (client alohida portda ishlaganda).
# Production'da server client/dist ni o'zi uzatadi — bitta origin, CORS kerak emas.
CLIENT_ORIGIN=http://localhost:5173

NODE_ENV=development
DB_PATH=./data/myhouseshop.db

# nginx / Render / Railway kabi reverse proxy ortida ishlaganda 'true' qiling,
# aks holda barcha so'rovlar bitta IP dan kelgandek ko'rinib, login cheklovi
# hamma foydalanuvchilarni birga bloklaydi.
TRUST_PROXY=false

# Brauzer sessiya cookie'sini faqat HTTPS orqali saqlashi kerakmi.
# HTTPS bor bo'lsa: true. Ichki tarmoqda (http://192.168.x.x) MAJBURIY false —
# aks holda login 200 qaytaradi, lekin cookie saqlanmay foydalanuvchi
# login sahifasiga qaytariladi.
COOKIE_SECURE=false

# Serverni tarmoqda ochish. 127.0.0.1 — faqat shu kompyuter.
HOST=0.0.0.0
